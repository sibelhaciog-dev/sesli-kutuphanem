# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase panelinde: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Yalnızca yerel betikler için (book:add, db:seed, db:export, db:types).
# Project Settings → Database → Connection string (URI)
# DİKKAT: Bu bağlantı tüm veriye erişir; Vercel'e EKLEMEYİN, yerelde kalsın.
DATABASE_URL=postgresql://postgres:PAROLA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Yalnızca `npm run book:add` ile kapak yüklemek için (ADR 0009).
# Project Settings → API Keys → Secret key. Tanımlı değilse kitaplar eklenir,
# kapaklar atlanır. DİKKAT: RLS'i baypas eder; Vercel'e EKLEMEYİN, depoya YAZMAYIN.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── Yapay zekâ (OpenAI uyumlu uç nokta) ─────────────────────────────────────
# Varsayılan sağlayıcı OpenRouter. Başka bir OpenAI uyumlu servis de olur.
# Tanımlı değilse kapak tarama ve rapor yorumu kapanır, uygulama çalışmaya devam eder.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Metin üretimi (okuma raporu yorumu) — kaliteli bir model tercih edin.
AI_TEXT_MODEL=anthropic/claude-sonnet-4.5

# Görsel tanıma (kitap kapağı okuma) — hızlı ve ucuz bir model yeterli.
AI_VISION_MODEL=google/gemini-2.5-flash

# Yapılandırılmış çıktı kademesi: auto | json_schema | json_object | none
# Modeliniz JSON şema desteklemiyorsa `json_object` ya da `none` verin;
# `auto` her istekte boşa bir tur attırır. Ayrıntı: docs/ai.md §4
# AI_STRUCTURED_OUTPUT=auto

# Bir isteğe ayrılan toplam süre (ms). Rotalardaki maxDuration 60 sn;
# bu değer ondan KISA olmalı ki zaman aşımında biz düzgün hata dönebilelim.
# AI_BUDGET_MS=35000

# ─── Site ────────────────────────────────────────────────────────────────────
# E-posta doğrulama bağlantılarının döneceği adres.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
